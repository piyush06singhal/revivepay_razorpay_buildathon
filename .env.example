# RevivePay Environment Configuration

# Set to true to enable live Razorpay API calls; false uses 100% deterministic simulator
ENABLE_LIVE_RAZORPAY_API="false"

# Razorpay Test Mode Credentials (Get these from your Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Optional Gemini API Key for dynamic LLM diagnosis (Fallback rules engine active when missing)
GEMINI_API_KEY=""
